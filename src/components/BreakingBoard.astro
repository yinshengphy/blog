---
interface BreakingItem {
  title: string;
  summary: string;
  source: string;
  discoveredAt: string;
  severity: string;
  link?: string;
}

interface Props {
  items: BreakingItem[];
}

const { items } = Astro.props;
const sortedItems = [...items].sort(
  (a, b) => new Date(b.discoveredAt).getTime() - new Date(a.discoveredAt).getTime()
);

function formatDate(value: string) {
  const d = new Date(value);
  const pad = (n: number) => String(n).padStart(2, '0');
  const year = d.getFullYear();
  const month = pad(d.getMonth() + 1);
  const day = pad(d.getDate());
  const hours = pad(d.getHours());
  const minutes = pad(d.getMinutes());
  const seconds = pad(d.getSeconds());
  return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
}
---

<section class="breaking-board" aria-labelledby="breaking-board-title">
  <div class="breaking-board-heading">
    <div>
      <p class="section-label">Realtime & Rolling Monitor</p>
      <h2 id="breaking-board-title">BREAKING</h2>
      <p>只保留最近重大突发监测事件，按最新发现时间滚动更新。</p>
    </div>
  </div>

  {sortedItems.length > 0 ? (
    <div class="breaking-board-list">
      {sortedItems.map((item) => (
        <article class="breaking-item">
          <div class="breaking-item-meta">
            <span>{item.severity}</span>
            <time datetime={item.discoveredAt}>{formatDate(item.discoveredAt)}</time>
          </div>
          <h3>
            {item.link ? (
              <a href={item.link} target="_blank" rel="noreferrer">{item.title}</a>
            ) : item.title}
          </h3>
          <p>{item.summary}</p>
          <small>{item.source}</small>
        </article>
      ))}
    </div>
  ) : (
    <p class="breaking-empty">最近三天暂无已收录突发新闻。</p>
  )}
</section>
