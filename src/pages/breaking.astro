---
import BaseLayout from '../layouts/BaseLayout.astro';
import rawBreakingNews from '../data/breaking-news.json';

const cutoff = Date.now() - 3 * 24 * 60 * 60 * 1000;
const items = rawBreakingNews
  .filter((item) => new Date(item.discoveredAt).getTime() >= cutoff)
  .sort((a, b) => new Date(b.discoveredAt).getTime() - new Date(a.discoveredAt).getTime());

function formatDate(value: string) {
  const d = new Date(value);
  const pad = (n: number) => String(n).padStart(2, '0');
  const year = d.getFullYear();
  const month = pad(d.getMonth() + 1);
  const day = pad(d.getDate());
  const hours = pad(d.getHours());
  const minutes = pad(d.getMinutes());
  const seconds = pad(d.getSeconds());
  return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
}

function makeSlug(text: string, index: number) {
  const clean = text
    .normalize('NFKC')
    .toLowerCase()
    .trim()
    .replace(/[`*_~[\](){}<>"'，。！？；：、]/g, '')
    .replace(/\s+/g, '-')
    .replace(/[^\p{Script=Han}\p{Letter}\p{Number}-]/gu, '')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  return clean ? `item-${index}-${clean.slice(0, 30)}` : `item-${index}`;
}

const itemsWithSlug = items.map((item, idx) => ({
  ...item,
  slug: makeSlug(item.title, idx + 1)
}));
---

<BaseLayout title="BREAKING" description="重大突发事件监测。">
  <article class="post-shell">
    <a class="back-link" href="/">返回首页</a>
    
    <header class="post-hero" style="grid-template-columns: 1fr; border-bottom: 1px solid var(--line);">
      <div class="post-intro">
        <div class="post-meta-row">
          <p class="meta">实时监测</p>
          <span class="meta-divider">·</span>
          <p class="meta">近 3 日突发</p>
          <span class="meta-divider">·</span>
          <p class="meta">{items.length} 条已收录</p>
        </div>
        <h1 id="breaking-board-title">BREAKING</h1>
        <p class="post-description">只保留最近重大突发监测事件，按最新发现时间滚动更新。</p>
      </div>
    </header>

    <div class="post-body-layout">
      <aside class="post-sidebar">
        {itemsWithSlug.length > 0 && (
          <section class="toc-panel" id="post-toc">
            <details class="toc-details" open>
              <summary class="toc-title toc-summary">快讯速览 ({itemsWithSlug.length})</summary>
              <div class="toc-scroll">
                <nav aria-label="快讯目录">
                  <ol class="toc-list">
                    {itemsWithSlug.map((item) => (
                      <li class="toc-level-1">
                        <a class="toc-link" href={`#${item.slug}`} data-target={item.slug}>
                          <span style="font-size: 11px; opacity: 0.7; margin-right: 4px;">[{formatDate(item.discoveredAt)}]</span>
                          {item.title}
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </div>
            </details>
          </section>
        )}
        <section class="author-panel">
          <p class="toc-title">快讯监测机制</p>
          <p>持续扫描全球主要通讯社与官方媒体，通过模型评估重大事件级别自动聚合推送。</p>
        </section>
      </aside>

      <div class="prose">
        <section class="breaking-board" style="border: none; padding: 0; background: transparent; box-shadow: none; backdrop-filter: none;" aria-labelledby="breaking-board-title">
          {itemsWithSlug.length > 0 ? (
            <div class="breaking-board-list">
              {itemsWithSlug.map((item) => (
                <article class="breaking-item" id={item.slug} style="scroll-margin-top: 88px;">
                  <div class="breaking-item-meta">
                    <span>{item.severity}</span>
                    <time datetime={item.discoveredAt}>{formatDate(item.discoveredAt)}</time>
                  </div>
                  <h3>
                    {item.link ? (
                      <a href={item.link} target="_blank" rel="noreferrer">{item.title}</a>
                    ) : item.title}
                  </h3>
                  <p>{item.summary}</p>
                  <small>{item.source}</small>
                </article>
              ))}
            </div>
          ) : (
            <p class="breaking-empty">最近三天暂无已收录突发新闻。</p>
          )}
        </section>
      </div>
    </div>
    {itemsWithSlug.length > 0 && (
      <a class="toc-return-link" href="#post-toc" aria-label="回到目录">
        目录
      </a>
    )}
  </article>
</BaseLayout>

<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.toc-link')
  );
  const tocDetails = document.querySelector<HTMLDetailsElement>('.toc-details');
  const tocReturnLink = document.querySelector<HTMLAnchorElement>('.toc-return-link');
  const mobileQuery = window.matchMedia('(max-width: 780px)');
  const observedHeadings = tocLinks
    .map((link) => document.getElementById(link.dataset.target || ''))
    .filter((heading): heading is HTMLElement => heading instanceof HTMLElement);
  const headingScrollOffset = 96;
  let manualTargetId: string | null = null;
  let manualTargetTimer: number | undefined;

  const syncTocDisclosure = () => {
    if (tocDetails) {
      tocDetails.open = !mobileQuery.matches;
    }
  };

  syncTocDisclosure();
  mobileQuery.addEventListener('change', syncTocDisclosure);

  const setActiveHeading = (id: string) => {
    tocLinks.forEach((link) => {
      const isActive = link.dataset.target === id;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    });

    observedHeadings.forEach((heading) => {
      heading.classList.toggle('is-active-heading', heading.id === id);
    });
  };

  const decodeHash = () => {
    const hash = window.location.hash.slice(1);
    try {
      return decodeURIComponent(hash);
    } catch {
      return hash;
    }
  };

  const syncActiveHeading = () => {
    if (manualTargetId) {
      setActiveHeading(manualTargetId);
      return;
    }

    let currentHeading = observedHeadings[0];
    observedHeadings.forEach((heading) => {
      if (heading.getBoundingClientRect().top <= headingScrollOffset) {
        currentHeading = heading;
      }
    });

    if (currentHeading) setActiveHeading(currentHeading.id);
  };

  const scrollToHeading = (id: string) => {
    const target = document.getElementById(id);
    if (!target) return;

    manualTargetId = id;
    if (manualTargetTimer) window.clearTimeout(manualTargetTimer);
    setActiveHeading(id);
    history.pushState({ tocHeading: id }, '', `#${encodeURIComponent(id)}`);
    target.scrollIntoView({ block: 'start', behavior: 'smooth' });
    manualTargetTimer = window.setTimeout(() => {
      manualTargetId = null;
      syncActiveHeading();
    }, 1200);
  };

  if (observedHeadings.length > 0) {
    if (window.location.hash) {
      const hashId = decodeHash();
      if (observedHeadings.some((heading) => heading.id === hashId)) {
        setActiveHeading(hashId);
      } else {
        syncActiveHeading();
      }
    } else {
      syncActiveHeading();
    }

    let scrollFrame = 0;
    const onScroll = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(() => {
        scrollFrame = 0;
        syncActiveHeading();
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', syncActiveHeading);

    window.addEventListener('hashchange', () => {
      const hashId = decodeHash();
      if (hashId && observedHeadings.some((heading) => heading.id === hashId)) {
        setActiveHeading(hashId);
      } else {
        syncActiveHeading();
      }
    });

    tocLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const targetId = link.dataset.target;
        if (targetId) scrollToHeading(targetId);
        if (tocDetails && mobileQuery.matches) {
          tocDetails.open = false;
        }
      });
    });

    tocReturnLink?.addEventListener('click', () => {
      if (tocDetails && mobileQuery.matches) {
        tocDetails.open = true;
      }
    });
  }
</script>
